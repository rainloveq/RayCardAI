generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CardStatus {
  pending
  generating
  completed
  failed
}

enum TransactionType {
  credit
  debit
}

enum OrderStatus {
  pending
  completed
  failed
  refunded
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  displayName  String
  image        String?
  points       Int      @default(20)
  isBanned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cards           Card[]
  transactions    PointTransaction[]
  orders          Order[]
  accounts        Account[]
  galleryCards    GalleryCard[]
  likes           Like[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Card {
  id                String     @id @default(uuid())
  userId            String
  originalImageUrl  String
  generatedImageUrl String?
  festival          String
  styleId           String
  styleType         String
  decorations       String[]
  greetingText      String
  extraInstructions String?
  status            CardStatus @default(pending)
  taskId            String?
  createdAt         DateTime   @default(now())
  completedAt       DateTime?

  user        User         @relation(fields: [userId], references: [id])
  galleryCard GalleryCard?

  @@index([userId])
  @@index([taskId])
}

model PointTransaction {
  id          String          @id @default(uuid())
  userId      String
  type        TransactionType
  amount      Int
  description String
  referenceId String?
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Order {
  id                  String      @id @default(uuid())
  userId              String
  amountHKD           Decimal     @db.Decimal(10, 2)
  points              Int
  stripeSessionId     String      @unique
  stripePaymentIntent String?
  status              OrderStatus @default(pending)
  createdAt           DateTime    @default(now())
  completedAt         DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([stripeSessionId])
}

model TempUpload {
  id        String   @id @default(uuid())
  data      Bytes
  mimeType  String   @default("image/jpeg")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model GalleryCard {
  cardId      String   @id
  userId      String
  isPublic    Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  card  Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes Like[]

  @@index([userId])
}

model Like {
  id            String   @id @default(uuid())
  userId        String
  galleryCardId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  galleryCard GalleryCard @relation(fields: [galleryCardId], references: [cardId], onDelete: Cascade)

  @@unique([userId, galleryCardId])
  @@index([galleryCardId])
}
